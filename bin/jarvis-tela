#!/usr/bin/env bash
# jarvis-tela — liga tudo do Jarvis e abre a tela (estilo filme) no navegador.
#
# Liga a IA (Ollama), o servidor do Jarvis (jarvis serve) e a tela em
# http://localhost:3000, e abre o navegador. É o que o botão Jarvis da área de
# trabalho roda. Para desligar, aperte Ctrl+C neste terminal.

set -uo pipefail

OPENJARVIS_HOME="${OPENJARVIS_HOME:-$HOME/.openjarvis}"
JARVIS_BIN="$OPENJARVIS_HOME/.venv/bin/jarvis"
TELA_DIR="${JARVIS_TELA_DIR:-$HOME/.local/share/jarvis-project/tela}"
# Porta própria do Jarvis: a 8000 costuma estar ocupada por outros projetos.
API_PORTA="${JARVIS_PORTA:-8765}"
API="http://127.0.0.1:$API_PORTA"
OLLAMA="http://127.0.0.1:11434"
PORTAS_TELA=(3000 3001 3002 3003)
LOG="$OPENJARVIS_HOME/jarvis-tela.log"
PIDS=()

desligar() {
    local pid
    for pid in "${PIDS[@]}"; do
        kill "$pid" 2>/dev/null
    done
}
trap desligar EXIT
# HUP: fechar a janela do terminal também desliga tudo.
trap 'echo; echo "Jarvis desligado."; exit 0' INT TERM HUP

# Mantém a janela aberta para dar tempo de ler o erro (aberto pelo botão).
falhar() {
    echo >&2
    echo "$*" >&2
    if [[ -t 0 ]]; then read -rp "Aperte Enter para fechar." _; fi
    exit 1
}

if [[ ! -f "$TELA_DIR/index.html" ]]; then
    falhar "Não achei a tela do Jarvis em $TELA_DIR. Rode o instalador de novo: bash instalar.sh"
fi

# O servidor precisa achar o jarvis-pc e o jarvis-mcp mesmo quando aberto pelo botão.
export PATH="$HOME/.local/bin:$PATH"

# Guarda as variáveis da sessão gráfica para o jarvis-pc usar, já que os
# comandos do Jarvis rodam sem elas.
if command -v jarvis-pc >/dev/null 2>&1; then
    jarvis-pc salvar-sessao
fi

# Confere que quem responde é o Jarvis, e não outro programa na mesma porta.
servidor_ligado() { curl -fs --max-time 2 "$API/v1/info" 2>/dev/null | grep -q '"agent"'; }
porta_livre() { ! (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
ollama_ligado() { curl -fs -o /dev/null --max-time 2 "$OLLAMA/api/tags"; }

# Abre a tela numa janela própria do Chrome (ou Chromium, Brave, Edge), com
# um perfil só do Jarvis em que o som pode tocar sem clicar na página: é o que
# deixa ele ouvir e falar sozinho. Sem nenhum deles, usa o navegador padrão.
abrir_navegador() {
    local nav
    for nav in google-chrome-stable google-chrome chromium chromium-browser brave-browser microsoft-edge-stable; do
        if command -v "$nav" >/dev/null 2>&1; then
            "$nav" --app="$1" --user-data-dir="$OPENJARVIS_HOME/navegador" \
                --autoplay-policy=no-user-gesture-required \
                --no-first-run --no-default-browser-check --password-store=basic >/dev/null 2>&1 &
            return
        fi
    done
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$1" >/dev/null 2>&1 &
    elif command -v wslview >/dev/null 2>&1; then
        wslview "$1" >/dev/null 2>&1 &
    fi
}

url_da_tela() { echo "http://localhost:$1/?api=$API"; }

# Porta onde a tela do Jarvis já está aberta, se estiver.
porta_da_tela() {
    local p
    for p in "${PORTAS_TELA[@]}"; do
        if curl -fs --max-time 2 "http://localhost:$p/" 2>/dev/null | grep -q "J.A.R.V.I.S."; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

# Clicou de novo no botão com tudo já ligado: só abre a tela.
if servidor_ligado && PORTA="$(porta_da_tela)"; then
    echo "O Jarvis já está ligado. Abrindo a tela..."
    abrir_navegador "$(url_da_tela "$PORTA")"
    sleep 1
    exit 0
fi

# ---- 1. IA (Ollama) ----
if ! ollama_ligado; then
    echo "Ligando a IA (Ollama)..."
    if systemctl list-unit-files ollama.service >/dev/null 2>&1; then
        # Os modelos ficam com o serviço do sistema; pode pedir a senha.
        systemctl start ollama 2>/dev/null || sudo systemctl start ollama
    elif command -v ollama >/dev/null 2>&1; then
        ollama serve >"$OPENJARVIS_HOME/ollama.log" 2>&1 &
        PIDS+=("$!")
    fi
    for _ in $(seq 1 30); do
        ollama_ligado && break
        sleep 1
    done
    ollama_ligado || falhar "A IA (Ollama) não ligou. Tente: sudo systemctl start ollama"
fi

# ---- 2. servidor do Jarvis ----
if servidor_ligado; then
    echo "O servidor do Jarvis já está ligado."
else
    if ! porta_livre "$API_PORTA"; then
        falhar "A porta $API_PORTA está ocupada por outro programa. Feche-o ou use outra porta: JARVIS_PORTA=8766 jarvis-tela"
    fi
    # Um servidor antigo travado (de uma janela fechada à força) impede o novo de ligar.
    "$JARVIS_BIN" stop >/dev/null 2>&1 || true

    # O servidor só aceita pedidos vindos da tela, nas portas dela.
    origens=""
    for p in "${PORTAS_TELA[@]}"; do
        origens+="${origens:+,}http://localhost:$p,http://127.0.0.1:$p"
    done
    echo "Ligando o servidor do Jarvis (na primeira vez demora alguns minutos)..."
    OPENJARVIS_CORS_ORIGINS="$origens" \
        "$JARVIS_BIN" serve --host 127.0.0.1 --port "$API_PORTA" >"$LOG" 2>&1 &
    SERVIDOR_PID=$!
    PIDS+=("$SERVIDOR_PID")
    for _ in $(seq 1 300); do
        servidor_ligado && break
        if ! kill -0 "$SERVIDOR_PID" 2>/dev/null; then
            tail -n 20 "$LOG" >&2
            falhar "O servidor do Jarvis parou com erro. Log completo: $LOG"
        fi
        sleep 1
    done
    servidor_ligado || falhar "O servidor demorou demais para ligar. Veja o log: $LOG"
fi

# ---- 3. tela ----
PORTA=""
for p in "${PORTAS_TELA[@]}"; do
    if porta_livre "$p"; then PORTA="$p"; break; fi
done
[[ -n "$PORTA" ]] || falhar "As portas ${PORTAS_TELA[*]} estão ocupadas. Feche o programa que usa uma delas."
python3 -m http.server "$PORTA" --bind 127.0.0.1 --directory "$TELA_DIR" >/dev/null 2>&1 &
PIDS+=("$!")
sleep 1

URL="$(url_da_tela "$PORTA")"
abrir_navegador "$URL"
# Desligar o Jarvis também fecha a janela dele.
PIDS+=("$!")

echo
echo "Jarvis ligado: IA, servidor e tela."
echo "Tela do Jarvis: $URL"
echo "Se o navegador não abriu, copie o endereço acima."
echo "Para desligar, aperte Ctrl+C aqui ou feche esta janela."
wait
